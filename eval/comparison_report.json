  "metric_definitions": {
    "event_matching": "Greedy 1:1 assignment. A prediction matches a GT event when: (a) camera matches (when require_camera), (b) |pred_ts - gt_midpoint| <= gt_half_window + time_tolerance_seconds, (c) prediction text contains >= keyword_overlap_min GT keywords (when GT lists keywords), (d) event_type matches (only when require_event_type). GT events in id order take the lowest-timestamp-error unmatched prediction.",
    "precision": "TP / (TP + FP); None when the denominator is 0.",
    "recall": "TP / (TP + FN); None when the denominator is 0.",
    "f1": "2*P*R / (P + R); 0.0 when P and R are defined but P + R == 0; None when P or R is undefined (zero denominator).",
    "timestamp_error": "For matched events: |pred_ts - gt_midpoint| in video-relative seconds. Absolute-timestamp error is |pred_abs - gt_midpoint_abs|, where gt_midpoint_abs is the midpoint of GT absolute_start/absolute_end when both parse (else whichever bound parses). Cases with missing or malformed absolute times are counted under unavailable counts, not filled.",
    "boundary_error": "Signed (pred_start - gt_start) and (pred_end - gt_end) in seconds when the prediction carries start/end_seconds; otherwise falls back to (pred_point - gt_start) and (pred_point - gt_end) using the single prediction timestamp. None when GT provides no boundaries.",
    "evidence_coverage": "Claims with >= 1 syntactically valid evidence reference / total claims.",
    "evidence_reference_validity": "References whose recording exists AND 0 <= timestamp <= recording duration / total references. Validity is existence only \u2014 it does NOT imply the evidence supports the claim.",
    "evidence_support_rate": "Human-annotated supported claims / human-annotated claims. Computed ONLY from explicit human annotations (supported true/false); unannotated claims are excluded and counted separately.",
    "unsupported_claim_rate": "Human-annotated unsupported claims / human-annotated claims.",
    "contradiction_rate": "Human-annotated contradicted claims / human-annotated claims.",
    "cross_camera_precision": "Predicted pairs in the VALID set / predicted pairs in (VALID + INVALID + UNLABELED). Ambiguous/excluded pairs never count.",
    "cross_camera_recall": "Predicted pairs in the VALID set / all VALID pairs; None when no valid pairs are labeled.",
    "false_association_count": "Predicted pairs in the INVALID set (unordered comparison).",
    "false_association_rate": "False association count / total predicted pairs; None when no pairs predicted."
  },
  "match_rules": {
    "time_tolerance_seconds": 2.0,
    "window_rule": "A prediction matches a GT event when |pred_ts - gt_midpoint| <= (gt_half_window + time_tolerance_seconds).",
    "require_camera": true,
    "require_event_type": false,
    "keyword_overlap_min": 1,
    "keyword_rule": "Prediction text (action_description + observed_facts + object_descriptions + scene_description, lowercased) must contain at least keyword_overlap_min of the GT expected_keywords.",
    "assignment": "Greedy 1:1 assignment: GT events in id order take the lowest-timestamp-error unmatched prediction satisfying all rules."
  },
