# Meta Model API (https://dev.meta.ai)
# Primary key name — get yours at dev.meta.ai
MODEL_API_KEY=your_model_api_key_here
# Legacy alias — still accepted if MODEL_API_KEY is unset
# META_API_KEY=your_key_here

META_API_BASE_URL=https://api.meta.ai/v1

# App config
FINDIT_DATA_DIR=./data
FINDIT_MAX_VIDEO_SIZE_MB=500
FINDIT_FRAME_EXTRACTION_FPS=1
FINDIT_MAX_FRAMES_PER_VIDEO=300
FINDIT_MAX_API_CALLS_PER_VIDEO=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
