# Meta Llama API
META_API_KEY=your_meta_api_key_here
META_API_BASE_URL=https://api.llama.com

# App config
FINDIT_DATA_DIR=./data
FINDIT_MAX_VIDEO_SIZE_MB=500
FINDIT_FRAME_EXTRACTION_FPS=1
FINDIT_MAX_FRAMES_PER_VIDEO=300
FINDIT_MAX_API_CALLS_PER_VIDEO=300
FINDIT_ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
