# Meta Model API (https://dev.meta.ai)
# Primary key name — get yours at dev.meta.ai
MODEL_API_KEY=your_model_api_key_here
# Legacy alias — still accepted if MODEL_API_KEY is unset
# META_API_KEY=your_key_here

META_API_BASE_URL=https://api.meta.ai/v1

# App config
FINDIT_DATA_DIR=./data
FINDIT_MAX_VIDEO_SIZE_MB=500
FINDIT_FRAME_EXTRACTION_FPS=1
FINDIT_MAX_FRAMES_PER_VIDEO=300
FINDIT_MAX_API_CALLS_PER_VIDEO=300

# AI credit budget safeguards (Phase 2)
# Total Meta API credit budget — raise BudgetExceededError when (spent + reserve) >= limit
BUDGET_LIMIT_USD=150.0
# Reserve floor: stop spending this many dollars before the hard limit
BUDGET_RESERVE_USD=10.0

# Model routing
VISION_PROVIDER=meta
# Use contributor-mode model ID if hackathon grants discounted access:
#   muse-spark-1.3-contributor  (input $0.10/1M, output $0.20/1M)
# Standard rate:
#   muse-spark-1.3              (input $1.25/1M, output $4.25/1M)
VISION_MODEL=muse-spark-1.3

# Retry settings (Phase 6: transient failures only, jittered backoff, Retry-After)
MAX_API_ATTEMPTS=3
BASE_BACKOFF_SECONDS=1.0
META_BACKOFF_MAX_S=8.0
META_RETRY_JITTER=true

# Meta API timeouts and token caps (Phase 6)
META_CONNECT_TIMEOUT_S=10.0
META_READ_TIMEOUT_S=60.0
META_TEXT_READ_TIMEOUT_S=45.0
VISION_MAX_OUTPUT_TOKENS=2000
TEXT_MAX_OUTPUT_TOKENS=1500

# Investigation resilience and cost safeguards (Phase 6)
AGENT_TIMEOUT_SECONDS=30.0
INVESTIGATION_TIMEOUT_SECONDS=120.0
INVESTIGATION_MAX_CONCURRENT=4
INVESTIGATION_MAX_LLM_CALLS=8

# Upload hardening (Phase 6)
UPLOAD_MAX_RECORDINGS=0
FFMPEG_TIMEOUT_S=300.0

# Cache retention (Phase 6; 0 = keep indefinitely, prune manually)
FRAME_CACHE_RETENTION_DAYS=0

# Security boundaries (Phase 6)
# API_TOKEN=change-me-in-production   # when set, mutating endpoints need X-API-Token
RATE_LIMIT_PER_MINUTE=240
MAX_QUERY_CHARS=2000
MAX_RECORDING_IDS=50

# Cost and performance (Phase 8)
LLM_MAX_CONCURRENT=2
AGENT_PARALLEL_PAIRS=true
INVESTIGATION_CACHE_TTL_S=3600
INVESTIGATION_CACHE_MAX_ENTRIES=200

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
